{
  "manifest_version": 1,
  "id": "io.github.caichangqing1120.prometheus",
  "name": "Prometheus",
  "version": "0.1.7",
  "publisher": "caichangqing1120",
  "description": "Read-only Prometheus query, targets, alerts and rules workbench",
  "icon": "assets/plugin.svg",
  "engines": { "dbx": ">=0.6.14", "host_api": "1" },
  "entrypoints": {
    "backend": { "executable": "bin/dbx-plugin-prometheus" },
    "ui": { "root": "ui", "entry": "ui/index.html" }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.caichangqing1120.prometheus.connection",
      "label": "Prometheus 连接",
      "icon": "assets/plugin.svg",
      "database_type": "prometheus-dbx-plugin",
      "fields": [
        { "key": "display_name", "label": "连接名称", "type": "text", "default": "Prometheus", "binding": "name" },
        { "key": "host", "label": "IP / 域名", "type": "text", "binding": "host", "required": true, "placeholder": "prometheus.example.com" },
        { "key": "port", "label": "端口", "type": "number", "binding": "port", "required": true, "default": 9090 },
        { "key": "scheme", "label": "协议", "type": "select", "binding": "config", "default": "http", "options": [{ "label": "HTTP", "value": "http" }, { "label": "HTTPS", "value": "https" }] },
        { "key": "context_path", "label": "应用路径", "type": "text", "binding": "config", "default": "/" },
        { "key": "username", "label": "Basic Auth 用户名（可选）", "type": "text", "binding": "username" },
        { "key": "password", "label": "Basic Auth 密码（可选）", "type": "password", "binding": "password" },
        { "key": "environment", "label": "环境标识", "type": "text", "binding": "config" }
      ],
      "workbench": "io.github.caichangqing1120.prometheus.workbench",
      "capabilities": ["test", "connect", "disconnect"]
    },
    {
      "type": "workbench",
      "id": "io.github.caichangqing1120.prometheus.workbench",
      "label": "Prometheus 工作台",
      "icon": "assets/plugin.svg"
    }
  ]
}
